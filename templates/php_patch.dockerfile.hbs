COPY patches/php-8.1-cve-2026-109618-109619.patch /tmp/php-8.1-cve-2026-109618-109619.patch

# PHP 8.1 is EOL: rebuild the image's own PHP source with the upstream backport (php-src branch PHP-8.1-CVE-2026-109618-109619)
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        $PHPIZE_DEPS \
        binutils \
        libargon2-dev \
        libcurl4-openssl-dev \
        libonig-dev \
        libreadline-dev \
        libsodium-dev \
        libsqlite3-dev \
        libssl-dev \
        libxml2-dev \
        patch \
        zlib1g-dev; \
    configureOptions="$(php-config --configure-options | sed 's/ --with-pear / /')"; \
    docker-php-source extract; \
    cd /usr/src/php; \
    patch -p1 < /tmp/php-8.1-cve-2026-109618-109619.patch; \
    CFLAGS="$PHP_CFLAGS" CPPFLAGS="$PHP_CPPFLAGS" LDFLAGS="$PHP_LDFLAGS" ./configure $configureOptions; \
    make -j"$(nproc)"; \
    make install; \
    cd /; \
    docker-php-source delete; \
    rm /tmp/php-8.1-cve-2026-109618-109619.patch; \
    nm -D /usr/local/bin/php | grep -q zend_mm_safe_error_ex; \
    nm -D /usr/local/sbin/php-fpm | grep -q zend_mm_safe_error_ex; \
    php -m > /dev/null
